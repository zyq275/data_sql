# 复制为 .env 后填入真实值；.env 不入版本库（NFR-SEC-003）
# 层级用双下划线分隔，环境变量优先级高于 conf/app_config.yaml

# ---- 应用 ----
APP__DEBUG=false

# ---- 元数据库（可写） ----
DB_META__HOST=127.0.0.1
DB_META__PORT=3306
DB_META__USER=root
DB_META__PASSWORD=
DB_META__DATABASE=data_agent_meta

# ---- 数仓库（只读账号，最小权限） ----
DB_DW__HOST=127.0.0.1
DB_DW__PORT=3306
DB_DW__USER=readonly
DB_DW__PASSWORD=
DB_DW__DATABASE=data_agent_dw

# ---- LLM（OpenAI 兼容，模型可插拔） ----
LLM__MODEL_NAME=deepseek-chat
LLM__BASE_URL=https://api.deepseek.com/v1
LLM__API_KEY=

# ---- Embedding 独立服务（必须） ----
# host 指向服务的 OpenAI 兼容根路径（以 /v1 结尾），即调用 POST {host}/embeddings
# 用 Ollama 提供 bge-m3 时填 http://127.0.0.1:11434/v1
EMBEDDING__HOST=http://127.0.0.1:8001/v1

# ---- Rerank 精排服务（可选，阶段 6） ----
# 没有部署就设 enabled=false：否则每次查询都会因连不上而打一条 WARNING。
# 功能不受影响——检索降级为 RRF 融合顺序。协议与 path 见 TDD 5.2.1 / 11
RERANK__ENABLED=true
RERANK__HOST=http://127.0.0.1:8002
# path / model / timeout 等未列出的项走 conf/app_config.yaml 的默认值。
# 想改就取消注释并填值——注意**留空会覆盖掉 YAML 的默认值**（比如把 model
# 设成空串会让请求体里的 model 变成 ""），要么填值要么整行别写
# RERANK__PATH=/rerank
# RERANK__MODEL=bge-reranker-v2-m3
# RERANK__API_KEY=            # 云服务才需要；值只写在这里，不进对话与代码

# ---- JWT ----
# 未配置时应用拒绝启动；生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT__SECRET_KEY=

# ---- 向量库 ----
# mode=server 连远程 Qdrant（默认）；mode=local 用 qdrant-client 嵌入式引擎，
# 仅用于没有 Qdrant 服务的本地开发，此时 local_path 必填、payload 索引不生效
QDRANT__MODE=server
QDRANT__LOCAL_PATH=

# ---- Redis（多轮会话状态，阶段 7） ----
# 会话的图状态快照存这里（TDD ADR-006）。没有 Redis 服务就设 enabled=false：
# 会话状态退回进程内存储，单实例开发不受影响，多实例共享与重启恢复失效，
# 且 /health/ready 的 redis 项会如实报 fail。本机：D:\agent\infra\start-redis.cmd
REDIS__ENABLED=true
REDIS__HOST=127.0.0.1
# REDIS__PORT=6379
# REDIS__DB=0
REDIS__PASSWORD=

# ---- 其他存储 ----
ES__USERNAME=
ES__PASSWORD=

# ---- CORS 白名单（JSON 数组；生产环境不得为 ["*"]） ----
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
