# 复制为 .env 后填入真实值；.env 不入版本库（NFR-SEC-003）
# 层级用双下划线分隔，环境变量优先级高于 conf/app_config.yaml

# ---- 应用 ----
APP__DEBUG=false

# ---- 元数据库（可写） ----
DB_META__HOST=127.0.0.1
DB_META__PORT=3306
DB_META__USER=root
DB_META__PASSWORD=
DB_META__DATABASE=data_agent_meta

# ---- 数仓库（只读账号，最小权限） ----
DB_DW__HOST=127.0.0.1
DB_DW__PORT=3306
DB_DW__USER=readonly
DB_DW__PASSWORD=
DB_DW__DATABASE=data_agent_dw

# ---- LLM（OpenAI 兼容，模型可插拔） ----
LLM__MODEL_NAME=deepseek-chat
LLM__BASE_URL=https://api.deepseek.com/v1
LLM__API_KEY=

# ---- Embedding / Rerank 独立服务 ----
EMBEDDING__HOST=http://127.0.0.1:8001
RERANK__HOST=http://127.0.0.1:8002

# ---- JWT ----
# 未配置时应用拒绝启动；生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT__SECRET_KEY=

# ---- 其他存储 ----
REDIS__PASSWORD=
ES__USERNAME=
ES__PASSWORD=

# ---- CORS 白名单（JSON 数组；生产环境不得为 ["*"]） ----
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
